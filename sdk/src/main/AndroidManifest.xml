<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- `reloadsOnReachable` watches for the network coming back -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Without it the advertising ID reads as zeros on API 33 and above -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- MRAID's `supports` asks whether the device can call or text; without these, package
         visibility hides the apps that can -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
    </queries>

</manifest>
